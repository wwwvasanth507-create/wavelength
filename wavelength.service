# ==============================================================================
# Wavelength Music Streaming & Admin Platform - Systemd Unit File
# Target Environment: Ubuntu 24.04 LTS (Noble Numbat)
# Installation Path: /opt/wave
# Usage:
#   1. Copy to /etc/systemd/system/wavelength.service
#   2. Run: sudo systemctl daemon-reload
#   3. Run: sudo systemctl enable --now wavelength
# ==============================================================================

[Unit]
Description=Wavelength Music Streaming & Admin Platform FastAPI Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=www-data
WorkingDirectory=/opt/wave

# Execute FastAPI via Python virtual environment uvicorn runner
ExecStart=/opt/wave/venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 7000 --workers 2

# Process Management & Auto-Restart Settings
Restart=always
RestartSec=5s
KillMode=mixed

# Environment Variables
Environment="PORT=7000"
Environment="JWT_SECRET=wavelength_ubuntu_24_04_secure_jwt_secret_key"
Environment="DATABASE_PATH=/opt/wave/wavelength.db"
Environment="UPLOADS_PATH=/opt/wave/uploads"

# Security & Sandboxing (Optional / Recommended for Ubuntu 24.04)
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wave

[Install]
WantedBy=multi-user.target
