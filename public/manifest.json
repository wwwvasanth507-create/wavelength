    "client_mode": "focus-existing"
  },
  "note_taking": {
    "new_note_url": "/#/library"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "share_target": {
    "action": "/#/search",
    "method": "GET",
    "params": {
      "title": "q",
      "text": "q",
      "url": "q"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+music",
      "url": "/#/%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Music",
      "short_name": "Search",
      "description": "Search for tracks, artists, and playlists",
      "url": "/#/search",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Your Library",
      "short_name": "Library",
      "description": "Open your music library and saved tracks",
      "url": "/#/library",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/*": [
          ".mp3",
