  "name": "Wavelength — Feel Every Beat",
  "short_name": "Wavelength",
  "description": "Next-Generation Music Streaming Experience with Hi-Fi Audio & Dynamic Ambient Design.",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
